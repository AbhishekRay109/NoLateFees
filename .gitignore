# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets: never commit
android/key.properties
*.jks
*.keystore
.env
env.json
app_config.json

# Test-only signing key with a public password, committed on purpose so every
# CI build is signed the same way. Never use it for a store release.
!android/app/ci-test.jks
